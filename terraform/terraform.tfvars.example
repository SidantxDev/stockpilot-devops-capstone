# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Do NOT put AWS credentials here - use `aws configure` or AWS SSO.

region             = "ap-south-1"
project            = "stockpilot"
environment        = "capstone"
vpc_cidr           = "10.20.0.0/16"
az_count           = 2
kubernetes_version = "1.34"

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND" # "SPOT" is ~60-70% cheaper for a demo
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
